<?xml version="1.0" encoding="utf-8"?><!-- Target symbol when unselected, light orange box with an orange outline and X -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="600dp"
    android:height="400dp"
    android:viewportWidth="600"
    android:viewportHeight="400">

    <!-- Box, inset by half the line width so the outline is not cut off at the edges -->
    <path
        android:fillColor="#FFCC80"
        android:strokeColor="#FB8C00"
        android:strokeWidth="20"
        android:pathData="M10,10 L590,10 L590,390 L10,390 Z" />

    <!-- X from corner to corner -->
    <path
        android:strokeColor="#FB8C00"
        android:strokeWidth="20"
        android:pathData="M10,10 L590,390 M590,10 L10,390" />
</vector>
